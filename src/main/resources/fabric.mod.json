{
	"schemaVersion": 1,
	"id": "combat-control",
	"version": "${version}",
	"name": "combat-control",
	"description": "Player-based combat control mod that aims brings back 1.8 combat to newer versions",
	"authors": [
		"LCLP"
	],
	"contact": {
		"homepage": "https://github.com/LCLPYT/combat-control",
		"sources": "https://github.com/LCLPYT/combat-control"
	},
	"license": "MPL-2.0",
	"icon": "assets/combat-control/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "work.lclpnet.combatctl.CCModInit"
		],
		"client": [
			"work.lclpnet.combatctl.CCClientMod"
		],
		"server": [
			"work.lclpnet.combatctl.CCServerInit"
		],
		"modmenu": [
			"work.lclpnet.combatctl.CCModMenu"
		]
	},
	"mixins": [
		"combat-control.mixins.json",
		{
			"config": "combat-control.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*",
		"kibu-hooks": "*",
		"kibu-networking-api": "*"
	},
	"suggests": {}
}