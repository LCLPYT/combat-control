{
	"schemaVersion": 1,
	"id": "combat-control",
	"version": "${version}",
	"name": "combat-control",
	"description": "Bring back classic combat from 1.8.9 and earlier. Remove the attack cooldown, re-introduce sword blocking and more!",
	"authors": [
		"LCLP"
	],
	"contact": {
		"homepage": "https://github.com/LCLPYT/combat-control",
		"sources": "https://github.com/LCLPYT/combat-control"
	},
	"license": "MPL-2.0",
	"icon": "assets/combat-control/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "work.lclpnet.combatctl.CCModInit"
		],
		"client": [
			"work.lclpnet.combatctl.CCClientMod"
		],
		"server": [
			"work.lclpnet.combatctl.CCServerInit"
		],
		"modmenu": [
			"work.lclpnet.combatctl.CCModMenu"
		]
	},
	"mixins": [
		"combat-control.mixins.json",
		{
			"config": "combat-control.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*",
		"kibu-hook-api": "*",
		"kibu-hooks": ">=0.57.0",
		"kibu-networking-api": "*",
		"kibu-config-api": "*",
		"kibu-scheduler-api": "*"
	},
	"suggests": {}
}